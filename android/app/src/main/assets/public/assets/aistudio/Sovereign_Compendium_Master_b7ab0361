#!/usr/bin/env python3
import http.server
import socketserver
import sqlite3
import json
import os

PORT = 3080
NEURAL_DB = "/data/data/com.termux/files/home/aurelius-sovereign/neural_memory.db"

class SovereignHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/status" or self.path == "/":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            data = {"status": "SOVEREIGN_ACTIVE", "node": os.uname().nodename}
            try:
                if os.path.exists(NEURAL_DB):
                    conn = sqlite3.connect(NEURAL_DB)
                    cur = conn.cursor()
                    cur.execute("SELECT COUNT(*) FROM neural_nodes")
                    data["indexed_vectors"] = cur.fetchone()[0]
                    conn.close()
            except Exception:
                data["indexed_vectors"] = 0
            self.wfile.write(json.dumps(data, indent=2).encode('utf-8'))
        else:
            self.send_response(404)
            self.end_headers()
            self.wfile.write(b'{"error": "Endpoint not found"}')

def run_gateway():
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(('127.0.0.1', PORT), SovereignHandler) as httpd:
        httpd.serve_forever()

if __name__ == "__main__":
    run_gateway()
```

